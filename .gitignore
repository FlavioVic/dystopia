# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.neon

# notas locais para agentes de IA (o guia do projeto é docs/ARQUITETURA.md)
CLAUDE.md
AGENTS.md

# playwright (`.auth`: sessão e segredo do autenticador do admin da stack de teste)
/test-results/
/playwright-report/
/playwright/.auth/

# capturas e snapshots do Playwright MCP (navegador usado pelo agente de IA)
/.playwright-mcp/

# fotos enviadas pelo painel em dev/teste (em produção ficam no Vercel Blob)
/.uploads/
