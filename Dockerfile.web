# App web (Next.js) — imagem de produção, para subir a stack inteira com
# `docker compose up`. A demo pública roda na Vercel e não usa esta imagem.
#
#   docker build -f Dockerfile.web -t dystopia-web .
#
# Três estágios: dependências, build (saída `standalone`, que copia só o que o
# servidor usa de node_modules) e a imagem final, sem código-fonte nem devDeps.

FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# O build carrega os módulos das rotas, e os dos bancos exigem DATABASE_URL e
# PAYMENTS_DATABASE_URL. A conexão é preguiçosa: estes endereços nunca são
# usados (nenhuma página consulta o banco no build). Os de verdade vêm do
# ambiente, em runtime.
ENV NEXT_TELEMETRY_DISABLED=1 NEXT_OUTPUT=standalone \
    DATABASE_URL=postgresql://build:build@127.0.0.1:1/build \
    PAYMENTS_DATABASE_URL=postgresql://build:build@127.0.0.1:1/build_payments
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public
USER node
EXPOSE 3000
CMD ["node", "server.js"]
