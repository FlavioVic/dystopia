# Banco (Postgres). Em dev, o docker-compose/container local costuma rodar na 5544.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/dystopia"

# RabbitMQ (fila). Em dev, o docker-compose sobe na 5672 e, sem esta
# variável, o app usa amqp://dystopia:dystopia_dev_pw@localhost:5672. Em
# produção é obrigatória (CloudAMQP, plano grátis: a URL amqps:// do painel).
RABBITMQ_URL="amqp://dystopia:dystopia_dev_pw@localhost:5672"

# Segredo do JWT de sessão (gere com: openssl rand -base64 32)
SESSION_SECRET="troque-por-um-segredo-aleatorio"

# --- opcionais -------------------------------------------------------------

# Banco usado por `npm test`. Se não definir, é o DATABASE_URL com "_test" no
# fim do nome do banco (o runner cria e migra sozinho).
# TEST_DATABASE_URL="postgresql://usuario:senha@localhost:5432/dystopia_test"

# Tamanho do pool do Postgres por processo (padrão 10). Em serverless (Vercel)
# use algo como 3: cada instância da função abre o próprio pool.
# PG_POOL_MAX="3"

# Seed (`npm run db:seed`). Contra banco que não seja localhost, o seed exige
# SEED_ALLOW_REMOTE=1 e uma SEED_ADMIN_PASSWORD com 16+ caracteres.
# SEED_ALLOW_REMOTE="1"
# SEED_ADMIN_PASSWORD="gere-com-openssl-rand-base64-24"
# SEED_CUSTOMER_PASSWORD="cliente123"

# E-mail de confirmação pelo Resend (worker). Sem a chave, entrega simulada.
# Com a chave, EMAIL_REDIRECT_TO é obrigatório (modo sandbox: tudo vai para esse
# endereço — use o e-mail da sua conta no Resend) a não ser que
# EMAIL_DELIVER_TO_RECIPIENTS=1 libere entregar ao comprador de verdade.
# RESEND_API_KEY="re_..."
# EMAIL_REDIRECT_TO="voce@exemplo.com"
# EMAIL_FROM="Dystopia <onboarding@resend.dev>"
# Quem recebe o alerta de cada pedido de orçamento (/servicos). Sem isto, o
# pedido só aparece em /admin/orcamentos.
# SERVICE_ALERT_TO="voce@exemplo.com"

# Stripe em modo de teste (cartão). Sem as chaves, cartão usa o simulado.
# A secreta é do processo de pagamentos; a pública vai para o app web. Só
# chaves de teste são aceitas (sk_test_/pk_test_).
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Assistente (chatbot). Sem a chave, o botão não aparece. Qualquer provedor no
# protocolo Chat Completions; o padrão é a Groq (plano grátis, sem cartão).
# CHAT_API_KEY="gsk_..."
# CHAT_API_URL="https://api.groq.com/openai/v1"
# CHAT_MODEL="llama-3.3-70b-versatile"
# ASSISTANT_LIMIT_PER_10MIN="20"

# Prefixo das exchanges/filas no broker (os testes usam "dystopia_test") e
# atrasos das filas de espera do retry, em ms.
# RABBITMQ_PREFIX="dystopia"
# RABBITMQ_RETRY_TIERS_MS="1000,5000,30000,120000"

# Worker embutido: sem processo de fila de pé (deploy só na Vercel), quem
# deixa trabalho na fila drena ela (pull) depois de responder. Em dev, deixe
# desligado e rode `npm run worker`. CRON_SECRET protege /api/cron/fila.
# INLINE_WORKER="1"
# CRON_SECRET="..."

# Worker da fila (`npm run worker`). "saga,notifications,payments" faz um
# processo só consumir também a fila de pagamentos (deploy com um container);
# o padrão é rodar pagamentos à parte com `npm run worker:payments`.
# WORKER_QUEUES="saga,notifications"
# WORKER_PREFETCH="5"
# WORKER_RELAY_MS="500"
# WORKER_RECONCILE_MS="30000"

# Atrás de um proxy reverso próprio que SOBRESCREVE X-Real-IP (fora da
# Vercel): sem isto, em produção o limite de tentativas não confia no IP do
# header — que o cliente forjaria — e passa a ser um contador só para todos.
# TRUST_PROXY_HEADERS="1"

# Limites de autenticação por IP (padrão de produção). A stack do compose
# aumenta para os testes de navegador.
# SIGNUP_LIMIT_PER_HOUR="5"
# LOGIN_LIMIT_PER_15MIN="10"
# SERVICE_REQUEST_LIMIT_PER_HOUR="5"

# Log: "debug" | "info" | "warn" | "error" e LOG_FORMAT=json para uma linha JSON
# LOG_LEVEL="info"
# LOG_FORMAT="json"

# Modo demonstração: o checkout ganha um seletor para forçar o caminho do
# gateway simulado (decline, flaky_once, unavailable) e ver a saga compensar.
# Seguro enquanto nada é cobrado de verdade (simulado ou Stripe em modo de
# teste) — com cobrança real, desligue.
# ALLOW_CHECKOUT_SIMULATION="1"
